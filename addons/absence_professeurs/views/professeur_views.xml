<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_professeur_tree" model="ir.ui.view">
        <field name="name">professeur.tree</field>
        <field name="model">absence.professeur</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="view_professeur_form" model="ir.ui.view">
        <field name="name">professeur.form</field>
        <field name="model">absence.professeur</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_professeur" model="ir.actions.act_window">
        <field name="name">Professeurs</field>
        <field name="res_model">absence.professeur</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
